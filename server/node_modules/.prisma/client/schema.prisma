datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==================== ENUMS ====================

enum Role {
  USER
  WORKER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum WorkerStatus {
  AVAILABLE
  ON_JOB
  INACTIVE
}

enum BookingStatus {
  PENDING
  PENDING_PARTNER_ACCEPTANCE
  PARTNER_ACCEPTED
  ASSIGNED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  CASH
}

enum NotificationType {
  BOOKING_ALERT
  WORKER_ASSIGNMENT
  PAYMENT_SUCCESS
  ADMIN_UPDATE
  SYSTEM_ALERT
}

// ==================== MODELS ====================

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String
  name            String
  phone           String   @unique
  role            Role     @default(USER)
  isEmailVerified Boolean  @default(false)
  isPhoneVerified Boolean  @default(false)
  pincode         String?
  serviceArea     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  bookings      Booking[]
  sessions      Session[]
  notifications Notification[]
  auditLogs     AuditLog[]
  reviewsLeft   Review[]       @relation("UserReviews")
  addresses     Address[]

  @@index([role])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServiceArea {
  id        String   @id @default(uuid())
  city      String   @default("Bengaluru")
  pincode   String   @unique // e.g. "560073" for Anchepalya / Prestige Jindal City
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relations
  bookings Booking[]
}

model Service {
  id           String   @id @default(uuid())
  name         String   @unique
  category     String // e.g. "Cleaning", "Care", "Cooking", "Shifting", "Painting", "Technical"
  description  String
  price        Float
  durationText String   @default("") // e.g. "6 Hours", "1 Hour"
  packageText  String   @default("") // e.g. "2BHK Package"
  imageUrl     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  bookingItems BookingItem[]
}

model ServicePartner {
  id          String   @id @default(uuid())
  name        String
  phone       String   @unique
  serviceType String // e.g. "Cleaning", "Care", "Cooking", "Shifting", "Painting", "Technical"
  status      String   @default("AVAILABLE") // "AVAILABLE", "ON_JOB", "INACTIVE"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  bookings Booking[]
  reviews  Review[]  @relation("PartnerReviews")
}

model PromoCode {
  id            String    @id @default(uuid())
  code          String    @unique // e.g. "9MINUTES", "WELCOME10"
  discountType  String    @default("PERCENTAGE") // "FLAT" or "PERCENTAGE"
  discountValue Float
  minOrderValue Float     @default(0.0)
  maxDiscount   Float? // Max cap for percentage discount
  usageLimit    Int? // Total uses allowed across all users
  perUserLimit  Int       @default(1) // Limit per user
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  usedCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Booking {
  id              String        @id @default(uuid())
  userId          String
  partnerId       String?
  serviceAreaId   String? // Make serviceAreaId optional for direct payments
  status          BookingStatus @default(PENDING)
  scheduledAt     DateTime
  timeSlot        String // e.g., "09:00 AM - 10:00 AM"
  address         String
  phone           String
  totalPrice      Float
  discountApplied Float         @default(0.0)
  finalPrice      Float
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   PaymentMethod @default(UPI)
  paymentId       String? // transaction ID from Razorpay webhook
  couponCode      String?
  serviceCategory String?
  acceptedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Booking Flow Redesign fields
  customer_name  String?
  email          String?
  service_name   String?
  amount         Float?
  area           String?
  pincode        String?
  notes          String?
  payment_status String? @default("Pending")
  transaction_id String?
  booking_status String? @default("New Booking")
  partnerName    String?
  partnerMobile  String?
  refundId       String?

  // Relations
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner     ServicePartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  serviceArea ServiceArea?    @relation(fields: [serviceAreaId], references: [id])
  items       BookingItem[]
  review      Review?

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([partnerId])
}

model BookingItem {
  id        String  @id @default(uuid())
  bookingId String
  serviceId String
  quantity  Int     @default(1)
  price     Float // Price captured at checkout time
  variant   String? // e.g. "2BHK" or "3BHK"

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  userId    String
  partnerId String
  rating    Int // 1 to 5 stars
  comment   String?
  createdAt DateTime @default(now())

  // Relations
  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User           @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)
  partner ServicePartner @relation("PartnerReviews", fields: [partnerId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  userName  String?  @map("user_name")
  userEmail String?  @map("user_email")
  userRole  String?  @map("user_role")
  eventType String   @default("SYSTEM") @map("event_type")
  action    String
  details   String? // JSON string of changes (backwards compatibility)
  metadata  String? // JSON details of changes
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([eventType])
  @@map("audit_logs")
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  houseFlat String
  street    String
  landmark  String?
  altMobile String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Waitlist {
  id            String   @id @default(uuid())
  name          String
  mobile        String
  email         String
  selected_area String?  @default("")
  pincode       String?  @default("")
  location      String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now()) @map("created_at")
}
