datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==================== ENUMS ====================

enum Role {
  USER
  WORKER
  ADMIN
}

enum WorkerStatus {
  AVAILABLE
  ON_JOB
  INACTIVE
}

enum BookingStatus {
  PENDING
  ASSIGNED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  CASH
}

enum NotificationType {
  BOOKING_ALERT
  WORKER_ASSIGNMENT
  PAYMENT_SUCCESS
  ADMIN_UPDATE
  SYSTEM_ALERT
}

enum AuditAction {
  USER_LOGIN
  SERVICE_CREATE
  SERVICE_UPDATE
  SERVICE_DELETE
  WORKER_CREATE
  WORKER_STATUS_CHANGE
  BOOKING_CANCEL
  PRICING_CHANGE
  COUPON_CREATE
}

// ==================== MODELS ====================

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String
  name            String
  phone           String   @unique
  role            Role     @default(USER)
  isEmailVerified Boolean  @default(false)
  isPhoneVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  bookings      Booking[]
  workerProfile Worker?
  sessions      Session[]
  notifications Notification[]
  auditLogs     AuditLog[]
  reviewsLeft   Review[]       @relation("UserReviews")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServiceArea {
  id        String   @id @default(uuid())
  city      String   @default("Bengaluru")
  pincode   String   @unique // e.g. "560073" for Anchepalya / Prestige Jindal City
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relations
  bookings Booking[]
}

model Service {
  id           String   @id @default(uuid())
  name         String   @unique
  category     String // e.g. "Cleaning", "Care", "Cooking", "Shifting", "Painting", "Technical"
  description  String
  price        Float
  durationText String   @default("") // e.g. "6 Hours", "1 Hour"
  packageText  String   @default("") // e.g. "2BHK Package"
  imageUrl     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  bookingItems BookingItem[]
  workerSkills WorkerSkill[]
}

model Worker {
  id             String       @id @default(uuid())
  userId         String       @unique
  status         WorkerStatus @default(AVAILABLE)
  rating         Float        @default(5.0)
  totalJobs      Int          @default(0)
  commissionRate Float        @default(0.70) // 70% to worker, 30% to JK Enterprises
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills   WorkerSkill[]
  bookings Booking[]
  reviews  Review[]      @relation("WorkerReviews")
}

model WorkerSkill {
  id        String   @id @default(uuid())
  workerId  String
  serviceId String
  createdAt DateTime @default(now())

  // Relations
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([workerId, serviceId])
}

model PromoCode {
  id          String    @id @default(uuid())
  code        String    @unique // e.g. "9MINUTES", "WELCOME10"
  discountPct Float
  isActive    Boolean   @default(true)
  usedCount   Int       @default(0)
  expiresAt   DateTime?
}

model Booking {
  id              String        @id @default(uuid())
  userId          String
  workerId        String?
  serviceAreaId   String
  status          BookingStatus @default(PENDING)
  scheduledAt     DateTime
  timeSlot        String // e.g., "09:00 AM - 10:00 AM"
  address         String
  phone           String
  totalPrice      Float
  discountApplied Float         @default(0.0)
  finalPrice      Float
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   PaymentMethod @default(UPI)
  paymentId       String? // transaction ID from Razorpay webhook
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  worker      Worker?       @relation(fields: [workerId], references: [id], onDelete: SetNull)
  serviceArea ServiceArea   @relation(fields: [serviceAreaId], references: [id])
  items       BookingItem[]
  review      Review?
}

model BookingItem {
  id        String  @id @default(uuid())
  bookingId String
  serviceId String
  quantity  Int     @default(1)
  price     Float // Price captured at checkout time
  variant   String? // e.g. "2BHK" or "3BHK"

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  userId    String
  workerId  String
  rating    Int // 1 to 5 stars
  comment   String?
  createdAt DateTime @default(now())

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)
  worker  Worker  @relation("WorkerReviews", fields: [workerId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  action    AuditAction
  details   String // JSON string of changes
  ipAddress String?
  createdAt DateTime    @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
